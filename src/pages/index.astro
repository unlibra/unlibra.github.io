---
// The page shared by docs.unlibra.com and yorucha.link: the same file in both
// repositories. What it shows is src/config/site.ts and
// src/content/projects/*.md; how it looks is DESIGN.md (tests/design.spec.js).
import { getCollection } from "astro:content";

// DM Mono for the section headings (500) and the numbers (400). Noto Sans JP
// is cut down to the shown characters after the build
// (scripts/noto-sans-jp-subset.mjs): it is not imported here.
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";

import booth from "../assets/logos/booth.svg";
import github from "../assets/logos/github.svg";
import unlibra from "../assets/logos/unlibra.svg";
import x from "../assets/logos/x.svg";
import youtube from "../assets/logos/youtube.svg";
import { type Logo, site } from "../config/site";
import "../styles/index.css";

/** Imported, so they get hashed names under /_astro/. A Logo without a file fails the type check. */
const LOGOS: Record<Logo, { src: string }> = { booth, github, unlibra, x, youtube };

// The projects, read only when a section lists them; a project file with no
// section to show it, or a section with no project, stops the build.
const projectSections = site.sections.filter((s) => s.kind === "projects").length;
if (projectSections > 1) throw new Error("Only one section can list the projects");
const projectFiles = Object.keys(import.meta.glob("../content/projects/**/*.md"));
if (projectSections === 0 && projectFiles.length > 0) {
  throw new Error("src/content/projects/ has projects, but no section lists them");
}
const projects =
  projectSections === 1
    ? (await getCollection("projects")).map((p) => p.data).sort((a, b) => a.order - b.order)
    : [];
if (projectSections === 1 && projects.length === 0) {
  throw new Error("A section lists the projects, but src/content/projects/ has none");
}
const orders = projects.map((p) => p.order);
const dup = orders.find((o, i) => orders.indexOf(o) !== i);
if (dup !== undefined) throw new Error(`Two projects share order ${dup}`);

/** Every row of the page, in order: the names and addresses. */
const rows = site.sections.flatMap((s) =>
  s.kind === "projects"
    ? projects.map((p) => ({ name: p.name, url: p.href }))
    : s.links.map((l) => ({ name: l.name, url: l.href })),
);

// The structured data: the site, and this page with what it is about. A profile
// page is about its owner (with every link as sameAs); a collection page lists
// its rows.
const owner = { "@type": "Person", ...site.author };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}#website`,
      name: site.name,
      url: site.url,
      description: site.description,
      inLanguage: site.lang,
      publisher: owner,
      author: owner,
    },
    {
      "@type": site.page,
      "@id": `${site.url}#page`,
      url: site.url,
      name: site.name,
      description: site.description,
      inLanguage: site.lang,
      isPartOf: { "@id": `${site.url}#website` },
      primaryImageOfPage: { "@type": "ImageObject", url: site.ogImage.url },
      mainEntity:
        site.page === "ProfilePage"
          ? { ...owner, sameAs: [...new Set([...site.author.sameAs, ...rows.map((r) => r.url)])] }
          : {
              "@type": "ItemList",
              itemListElement: rows.map((r, i) => ({ "@type": "ListItem", position: i + 1, name: r.name, url: r.url })),
            },
    },
  ],
};

// The arrows: Tabler Icons (outline), chevron-right for a page on this site and
// arrow-up-right for another site. MIT License, Copyright (c) 2020-2026 Paweł Kuna:
// LICENSES/Tabler-MIT.txt. DESIGN.md 9.4.
const TABLER = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
} as const;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{site.name}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={site.author.name} />
    <meta name="robots" content={site.robots} />
    <link rel="canonical" href={site.url} />
    <link rel="author" href={site.author.url} />
    <!-- Light or dark as the system is set (DESIGN.md 7.1): the page's background -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#333842" media="(prefers-color-scheme: dark)" />

    {site.icons.ico && <link rel="icon" href={site.icons.ico} sizes="32x32" />}
    <link rel="icon" href={site.icons.svg} type="image/svg+xml" />
    {site.icons.appleTouch && <link rel="apple-touch-icon" href={site.icons.appleTouch} />}

    <!-- Share cards: the small card -->
    <meta property="og:type" content={site.page === "ProfilePage" ? "profile" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:image" content={site.ogImage.url} />
    <meta property="og:image:type" content={site.ogImage.type} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    {site.page === "ProfilePage" && <meta property="profile:username" content={site.author.name} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={site.name} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={site.ogImage.url} />
    <meta name="twitter:image:alt" content={site.ogImage.alt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <main>
      <header>
        <h1>{site.name}</h1>
        {site.lead && <p>{site.lead}</p>}
      </header>

      {
        site.sections.map((section) => (
          <section class={section.kind} style={`--c: var(--${section.color})`}>
            <h2>{section.label}</h2>
            {section.kind === "projects" ? (
              <ol>
                {projects.map((p) => (
                  <li>
                    <a href={p.href}>
                      <b>{p.name}</b>
                      <span class="desc">{p.description}</span>
                      <svg class="go" viewBox="0 0 24 24" {...TABLER}>
                        <path d="M9 6l6 6l-6 6" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ol>
            ) : (
              <ul>
                {section.links.map((l) => (
                  <li>
                    <a href={l.href} rel="me">
                      <img class:list={["logo", `logo-${l.logo}`]} src={LOGOS[l.logo].src} width="18" height="18" alt="" />
                      <b>{l.name}</b>
                      <svg class="go" viewBox="0 0 24 24" {...TABLER}>
                        <path d="M17 7l-10 10" />
                        <path d="M8 7l9 0l0 9" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </main>
  </body>
</html>
