---
// The portal: the list of projects whose documentation this site hosts, then
// links to other sites. Projects are src/content/projects/*.md, the rest of the
// page src/config/site.ts.
import { getCollection } from "astro:content";

import "@fontsource-variable/noto-sans-jp";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";

import { type Logo, site } from "../config/site";
import "../styles/index.css";

const projects = (await getCollection("projects")).map((p) => p.data).sort((a, b) => a.order - b.order);
const orders = projects.map((p) => p.order);
const dup = orders.find((o, i) => orders.indexOf(o) !== i);
if (dup !== undefined) throw new Error(`Two projects share order ${dup}`);

// The description for search results, share cards and the structured data: the
// lead and the names of the projects.
const names = projects.map((p) => p.name);
const description = `${site.lead.replace(/\.$/, "")}: ${
  names.length > 1 ? `${names.slice(0, -1).join(", ")} and ${names.at(-1)}` : names[0]
}.`;

// The structured data: the site, and this page as the list of the projects.
const author = { "@type": "Person", ...site.author };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}#website`,
      name: site.title,
      alternateName: new URL(site.url).host,
      url: site.url,
      description,
      inLanguage: site.lang,
      publisher: author,
      author,
    },
    {
      "@type": "CollectionPage",
      "@id": `${site.url}#page`,
      url: site.url,
      name: site.title,
      description,
      inLanguage: site.lang,
      isPartOf: { "@id": `${site.url}#website` },
      primaryImageOfPage: { "@type": "ImageObject", url: site.ogImage.url },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: projects.map((p, i) => ({
          "@type": "ListItem",
          position: i + 1,
          url: p.href,
          name: p.name,
          description: p.description,
        })),
      },
    },
  ],
};

// GitHub's Invertocat (https://github.com/logos), a trademark of GitHub, Inc.
const GITHUB_PATH =
  "M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z";
// The drawing of each logo. A new Logo without one fails the type check.
const LOGOS: Record<Logo, { viewBox: string; path: string } | { src: string }> = {
  github: { viewBox: "0 0 98 96", path: GITHUB_PATH },
  unlibra: { src: "/brand/symbol.svg" },
};
const seeAlso = site.seeAlso.links.map((l) => ({ ...l, drawing: LOGOS[l.logo] }));

// The arrows: Tabler Icons (outline), chevron-right for a page on this site and
// arrow-up-right for another site. MIT License, Copyright (c) 2020-2026 Paweł Kuna:
// LICENSES/Tabler-MIT.txt. DESIGN.md 9.3.
const TABLER = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
} as const;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{site.title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={site.url} />
    <link rel="author" href={site.author.url} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={site.themeColor} />

    <!-- The same icons as unlibra.com (the files are copies of its own). -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Share cards: the same image as unlibra.com, as the small card. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:image" content={site.ogImage.url} />
    <meta property="og:image:type" content={site.ogImage.type} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.ogImage.url} />
    <meta name="twitter:image:alt" content={site.ogImage.alt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main>
      <header>
        <h1>{site.name}</h1>
        <p>{site.lead}</p>
      </header>

      <section class="projects">
        <h2>{site.projectsLabel}</h2>
        <ol>
          {
            projects.map((p) => (
              <li>
                <a href={p.href}>
                  <b>{p.name}</b>
                  <span class="desc">{p.description}</span>
                  <svg class="go" viewBox="0 0 24 24" {...TABLER}>
                    <path d="M9 6l6 6l-6 6" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="see-also">
        <h2>{site.seeAlso.label}</h2>
        <ul>
          {
            seeAlso.map((l) => (
              <li>
                <a href={l.href}>
                  {"src" in l.drawing ? (
                    <img class="logo" src={l.drawing.src} width="18" height="18" alt="" />
                  ) : (
                    <svg class="logo" viewBox={l.drawing.viewBox} aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d={l.drawing.path} fill="currentColor" />
                    </svg>
                  )}
                  <b>{l.name}</b>
                  <svg class="go" viewBox="0 0 24 24" {...TABLER}>
                    <path d="M17 7l-10 10" />
                    <path d="M8 7l9 0l0 9" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
