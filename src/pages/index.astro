---
// The portal: one list of links, grouped by section. Links are src/content/links/*.md,
// the site settings src/config/site.ts.
import { getCollection } from "astro:content";

import { site } from "../config/site";
import "../styles/index.css";

const links = await getCollection("links");

const sections = site.sections.map((section) => ({
  ...section,
  links: links
    .filter((link) => link.data.section === section.id)
    .map((link) => link.data)
    .sort((a, b) => a.order - b.order),
}));
const empty = sections.find((s) => s.links.length === 0);
if (empty) throw new Error(`Section ${empty.id} has no links`);
const orders = sections.flatMap((s) => s.links.map((l) => `${s.id}:${l.order}`));
const dup = orders.find((o, i) => orders.indexOf(o) !== i);
if (dup) throw new Error(`Two links share an order in a section: ${dup}`);

const SITE_URL = "https://docs.unlibra.com/";
const description = "Index of projects hosted on docs.unlibra.com";
// The projects whose documentation this site hosts, for the structured data.
const hosted = links.filter((link) => link.data.href.startsWith(SITE_URL)).map((link) => link.data);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "docs.unlibra.com",
  url: SITE_URL,
  publisher: { "@type": "Person", name: "unlibra", url: "https://unlibra.com" },
  hasPart: hosted.map((link) => ({ "@type": "WebSite", name: link.name, url: link.href })),
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE_URL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- The same OGP image as unlibra.com, for every site on docs.unlibra.com. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="docs.unlibra.com" />
    <meta property="og:title" content="docs.unlibra.com" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content="https://unlibra.com/ogp.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=JetBrains+Mono:wght@500;600&display=swap"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main>
      <header>
        <h1>{site.name}</h1>
        <p>{site.lead}</p>
      </header>
      {
        sections.map((section) => (
          <section style={`--c:${section.color}`}>
            <h2>{section.id}</h2>
            <ul>
              {section.links.map((link) => (
                <li>
                  <a href={link.href} style={`--lc:${link.color}`}>
                    <b>{link.name}</b>
                    <small>{link.category}</small>
                    <span>{link.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>
  </body>
</html>
